<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".activities.MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".activities.ReportDetailsActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".activities.SplashActivity"
            android:theme="@style/Theme.QWater.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.ReportAnalysisActivity"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".activities.ReportSaveActivity"
            android:theme="@style/AppTheme.PopupTheme" />
        <activity
            android:name=".activities.SourcePickerActivity"
            android:theme="@style/AppTheme.PopupTheme" />
        <activity
            android:name=".help.CoherenceActivity"
            android:theme="@style/AppTheme.PopupTheme" />
        <activity
            android:name=".help.SalinityActivity"
            android:theme="@style/AppTheme.PopupTheme" />
        <activity
            android:name=".help.SarActivity"
            android:theme="@style/AppTheme.PopupTheme" />
        <activity
            android:name=".help.ToxicityActivity"
            android:theme="@style/AppTheme.PopupTheme" />
        <activity
            android:name=".help.PhActivity"
            android:theme="@style/AppTheme.PopupTheme" />
        <activity
            android:name=".help.AboutActivity"
            android:theme="@style/AppTheme.PopupTheme" />
        <activity
            android:name=".activities.SourceDetailsActivity"
            android:theme="@style/AppTheme.NoActionBar" />

    </application>

</manifest>
